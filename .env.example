EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DETAIL_WORKERS=8

# Local detector: yolo_world works immediately; custom_yolo is the long-term target.
DETECTOR_BACKEND=yolo_world
YOLO_WORLD_MODEL=yolov8s-worldv2.pt
YOLO_WORLD_CLASSES=LEGO minifigure;LEGO minifig
YOLO_CUSTOM_MODEL=models/minifigure_detector.pt
YOLO_DEVICE=auto
YOLO_IOU=0.55

# Fast broad sweep over first/middle/last photos.
OVERVIEW_SAMPLE_IMAGES=3
OVERVIEW_BATCH_SIZE=16
OVERVIEW_IMGSZ=512
OVERVIEW_CONFIDENCE=0.10

# Deeper local scan only for promising listings.
DETAIL_BATCH_SIZE=12
DETAIL_IMGSZ=896
DETAIL_CONFIDENCE=0.14
MAX_LISTING_IMAGES=12
MAX_FIGURES_PER_IMAGE=20

IMAGE_DHASH_DISTANCE=6
IMAGE_DOWNLOAD_WORKERS=12

BRICKOGNIZE_WORKERS=4
BRICKOGNIZE_MIN_SIMILARITY=0.72
BRICKOGNIZE_TOP_K=5

BRICKLINK_CONSUMER_KEY=your_consumer_key
BRICKLINK_CONSUMER_SECRET=your_consumer_secret
BRICKLINK_TOKEN_VALUE=your_access_token
BRICKLINK_TOKEN_SECRET=your_token_secret
BRICKLINK_COUNTRY_CODE=
BRICKLINK_CURRENCY=USD
PRICE_CACHE_HOURS=6

SEARCH_CONFIG=searches.json
CONTINUOUS_SCAN=false
SCAN_INTERVAL_MINUTES=5

SAVE_BOXED_PREVIEWS=true
BOXED_PREVIEW_DIR=debug_boxes
DB_PATH=deal_finder.db
